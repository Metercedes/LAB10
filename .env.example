# Database Configuration
DB_URL=jdbc:sqlite:mydb.sqlite

# JWT Configuration  
# IMPORTANT: Generate a secure base64-encoded secret (at least 256 bits / 32 bytes) for production!
# Example: openssl rand -base64 32
JWT_SECRET=your-base64-encoded-secret-key-here-minimum-256-bits
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=86400000

# Rate Limiting Configuration
# General API rate limit (requests per minute)
RATE_LIMIT_RPM=60
# Authentication endpoints rate limit (stricter to prevent brute force)
RATE_LIMIT_AUTH_RPM=10
